# ========================================================
# AI Mystery Room - Environment Configuration Template
# ========================================================

# Deployment Environment ('production' in production hosting, 'development' locally)
NODE_ENV=production

# Web server port (Default: 5000; dynamically set by Render/Railway/Heroku/Fly.io)
PORT=5000

# MongoDB Database Connection String
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_mystery_room?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/ai_mystery_room?retryWrites=true&w=majority

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Session Secret (Generate a random string of at least 32 characters for JWT authentication)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_string_with_at_least_32_characters_here

# Allowed Client Origins for CORS (Comma-separated)
# In unified/monolithic hosting (Express serves frontend), requests from the same domain are automatically permitted.
# In decoupled setups, add your frontend domain (e.g., https://your-app.vercel.app).
CLIENT_ORIGIN=http://localhost:5173

# Cookie SameSite setting ('lax' for single-domain/monolith deployment; 'none' for cross-domain decoupled deployments)
COOKIE_SAME_SITE=lax

# Frontend API Base URL (Only needed during client build if frontend is deployed separately from backend)
# VITE_API_BASE_URL=https://your-api-domain.com/api/v1
